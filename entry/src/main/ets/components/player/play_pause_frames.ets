function interpolate(samples: number[], progress: number): number {
  const t: number = Math.max(0, Math.min(1, progress)) * (samples.length - 1);
  const low: number = Math.floor(t), high: number = Math.min(samples.length - 1, low + 1);
  return samples[low] + (samples[high] - samples[low]) * (t - low);
}
export function playPauseOpacity(path: number, progress: number): number { return interpolate(OPACITY[path], progress); }
export function playPauseCoordinates(path: number, progress: number): number[] {
  const t: number = Math.max(0, Math.min(1, progress)) * 15;
  const low: number = Math.floor(t), high: number = Math.min(15, low + 1);
  const a: number[] = FRAMES[path][low], b: number[] = FRAMES[path][high];
  const result: number[] = [];
  for (let i: number = 0; i < a.length; i++) {
    result.push((a[i] + (b[i] - a[i]) * (t - low)) * 20 / 48);
  }
  return result;
}
