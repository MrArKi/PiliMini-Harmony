# 仅允许公开开发工程、构建工具和必要的开源说明进入仓库。
# 顶层采用白名单，新增目录需显式决定是否公开。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/AppScope/
!/entry/
!/hvigor/
!/hvigorfile.ts
!/hvigorw
!/hvigorw.bat
!/oh-package.json5
!/oh-package-lock.json5
!/build-profile.json5
!/tools/

# entry只收集应用源码和构建配置；libs由准备脚本生成。
/entry/*
!/entry/src/
!/entry/hvigorfile.ts
!/entry/build-profile.json5
!/entry/oh-package.json5
!/entry/oh-package-lock.json5
!/entry/obfuscation-rules.txt
/entry/src/*
!/entry/src/main/
/entry/src/main/*
!/entry/src/main/ets/
!/entry/src/main/cpp/
!/entry/src/main/resources/
!/entry/src/main/module.json5

# 仅保留可复现构建所需的辅助工具。
/tools/*
!/tools/dev.sh
!/tools/prepare-player-deps.cjs
!/tools/build-player-simulator.cjs
!/tools/player-simulator-sources.json
/hvigor/*
!/hvigor/hvigor-config.json5
!/hvigor/hvigor-wrapper.js

# 本地文档、账号证据、参考项目、下载缓存与agent/IDE状态。
/docs/
/.local-evidence/
/local-evidence/
/_nara/
/.local-deps/
/release/
**/AGENTS.md
**/.codex/
**/.claude/
**/.idea/
**/.vscode/
**/.hvigor/
**/.cxx/
**/.preview/
**/build/
**/oh_modules/
**/node_modules/
**/.cache/
**/evidence/
**/screenshots/

# 签名、环境、账号数据与设备日志（所有层级）。
**/local.properties
**/.env
**/.env.*
**/*signing*.json
**/*signing*.json5
**/cookies.json
**/cookie.json
**/credentials.json
**/token.json
*.p12
*.p7b
*.cer
*.crt
*.jks
*.keystore
*.pem
*.key
*.pfx
*.der
*.log
*.hprof
*.heapsnapshot
*.db
*.db-*
*.sqlite
*.sqlite3
*.bak
*.tmp
*.swp
*~

# 二进制依赖和构建/打包产物不入源码仓库。
*.hap
*.hsp
*.har
*.so
*.a
*.o
*.obj
*.dll
*.exe
*.zip
*.7z
*.tar
*.tgz
*.gz
.DS_Store
Thumbs.db
